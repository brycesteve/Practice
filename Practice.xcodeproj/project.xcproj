{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "PracticeWidgetExtensionExtension.entitlements" },
    { "path": "PracticeWatchWidgetExtensionExtension.entitlements" },
    { "path": "Launch Screen.storyboard", "target-membership": [ "Practice/resources" ] },
    {
      "kind": "folder",
      "path": "Shared",
      "target-membership": [
        "Practice",
      ],
      "membership-exceptions": [
        {
          "target": "PracticeWatch Watch App",
          "inclusions": [
            "Data/AppGroupDefaults.swift",
            "Data/BodyMeasurements.swift",
            "Data/Exercises.swift",
            "Data/SharedModels.swift",
            "Data/SkillProgressions.swift",
            "Data/Skills.swift",
            "Data/WorkoutData.swift",
            "Engine/BodyCompositionCalculator.swift",
            "Engine/BodyMeasurementOutbox.swift",
            "Engine/HealthKitBodyMeasurements.swift",
            "Engine/HealthKitManager.swift",
            "Engine/NotificationManager.swift",
            "Engine/ProgressionEngine.swift",
            "Engine/RecoveryEngine.swift",
            "Engine/ScaleProtocol.swift",
            "Engine/TrainingIntegrity.swift",
            "Engine/WatchConnectivityManager.swift",
            "Errors/ErrorBanner.swift",
            "Errors/ErrorState.swift",
            "Logger.swift",
            "PracticeIcon.icon",
            "SharedAssets.xcassets",
          ],
        }, {
          "target": "PracticeWatchWidgetExtensionExtension",
          "inclusions": [
            "Data/AppGroupDefaults.swift",
            "Data/BodyMeasurements.swift",
            "Data/Exercises.swift",
            "Data/SharedModels.swift",
            "Data/SkillProgressions.swift",
            "Data/Skills.swift",
            "Data/WorkoutData.swift",
            "Engine/BodyCompositionCalculator.swift",
            "Engine/BodyMeasurementOutbox.swift",
            "Engine/HealthKitBodyMeasurements.swift",
            "Engine/HealthKitManager.swift",
            "Engine/NotificationManager.swift",
            "Engine/ProgressionEngine.swift",
            "Engine/RecoveryEngine.swift",
            "Engine/ScaleProtocol.swift",
            "Engine/TrainingIntegrity.swift",
            "Engine/WatchConnectivityManager.swift",
            "Logger.swift",
            "SharedAssets.xcassets",
          ],
        }, {
          "target": "PracticeWidgetExtensionExtension",
          "inclusions": [
            "Data/AppGroupDefaults.swift",
            "Data/BodyMeasurements.swift",
            "Data/Exercises.swift",
            "Data/SharedModels.swift",
            "Data/SkillProgressions.swift",
            "Data/Skills.swift",
            "Data/WorkoutData.swift",
            "Engine/BodyCompositionCalculator.swift",
            "Engine/BodyMeasurementOutbox.swift",
            "Engine/HealthKitBodyMeasurements.swift",
            "Engine/HealthKitManager.swift",
            "Engine/NotificationManager.swift",
            "Engine/ProgressionEngine.swift",
            "Engine/RecoveryEngine.swift",
            "Engine/ScaleProtocol.swift",
            "Engine/TrainingIntegrity.swift",
            "Engine/WatchConnectivityManager.swift",
            "Logger.swift",
            "SharedAssets.xcassets",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Practice",
      "target-membership": [
        "Practice",
      ],
      "membership-exceptions": [
        {
          "target": "Practice",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "PracticeWatchWidgetExtension",
      "target-membership": [
        "PracticeWatchWidgetExtensionExtension",
      ],
      "membership-exceptions": [
        {
          "target": "PracticeWatchWidgetExtensionExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "PracticeWidgetExtension",
      "target-membership": [
        "PracticeWidgetExtensionExtension",
      ],
      "membership-exceptions": [
        {
          "target": "PracticeWidgetExtensionExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "PracticeTests", "target-membership": [ "PracticeTests" ] },
    { "kind": "folder", "path": "PracticeWatchTests", "target-membership": [ "PracticeWatchTests" ] },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework",
          "target-membership": [
            "PracticeWatchWidgetExtensionExtension/frameworks",
            "PracticeWidgetExtensionExtension/frameworks",
          ],
        }, {
          "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "PracticeWatchWidgetExtensionExtension/frameworks",
            "PracticeWidgetExtensionExtension/frameworks",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Practice.app", "id": "AA5389AE2DE2083D008CA062", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/PracticeWatch Watch App.app", "id": "AA5389C02DE208B0008CA062", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Practice/copy/Embed Watch Content", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/PracticeWatchWidgetExtensionExtension.appex", "id": "AA5EAEDF2E43F34F00A2743F", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "PracticeWatch Watch App/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/PracticeWidgetExtensionExtension.appex", "id": "AA5EAEFE2E4919BF00A2743F", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Practice/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/PracticeTests.xctest", "id": "AA1336BE30432DDF00897A86", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/PracticeWatchTests.xctest", "id": "AA1336C930432DE400897A86", "type": "wrapper.cfbundle", "index": false },
      ],
    },
    { "kind": "folder", "path": "PracticeWatch Watch App", "target-membership": [ "PracticeWatch Watch App" ] },
  ],
  "targets": [
    {
      "name": "Practice",
      "id": "AA5389AD2DE2083D008CA062",
      "product": "Products/Practice.app",
      "product-type": "application",
      "dependencies": [
        "PracticeWatch Watch App",
        "PracticeWidgetExtensionExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "PracticeIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "NO",
        "CODE_SIGN_ENTITLEMENTS": "Practice/Practice.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "12",
        "DEVELOPMENT_TEAM": "XHMLRUNE5V",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Practice/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.healthcare-fitness",
        "INFOPLIST_KEY_NSHealthShareUsageDescription": "Read workouts, height, date of birth, biological sex and waist measurements to personalise training and calculate body-composition estimates.",
        "INFOPLIST_KEY_NSHealthUpdateUsageDescription": "Save workouts, measured weight and waist, and estimated body fat and lean body mass to Apple Health.",
        "INFOPLIST_KEY_NSSiriUsageDescription": "Allow Siri to start workouts",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.8",
        "PRODUCT_BUNDLE_IDENTIFIER": "net.stevebryce.Practice",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "VERSIONING_SYSTEM": "apple-generic",
      },
    }, {
