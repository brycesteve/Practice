        "INFOPLIST_KEY_CFBundleDisplayName": "Practice",
        "INFOPLIST_KEY_NSBluetoothAlwaysUsageDescription": "Listen to your Bluetooth scale to record weight and impedance when you start a body measurement.",
        "INFOPLIST_KEY_NSHealthShareUsageDescription": "Read workouts, height, date of birth, biological sex and waist measurements to personalise training and calculate body-composition estimates.",
        "INFOPLIST_KEY_NSHealthUpdateUsageDescription": "Save workouts, measured weight and waist, and estimated body fat and lean body mass to Apple Health.",
        "INFOPLIST_KEY_NSSiriUsageDescription": "Allow Siri to start Workouts",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "INFOPLIST_KEY_WKCompanionAppBundleIdentifier": "net.stevebryce.Practice",
        "LD_RUNPATH_SEARCH_PATHS": [
